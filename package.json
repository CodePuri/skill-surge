{
  "name": "skill-surge",
  "version": "2.2.4",
  "description": "Your agent's skill library. 29 curated skills. Auto-install to Claude Code, OpenCode, Cline, and more.",
  "type": "module",
  "bin": {
    "skill-surge": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build",
    "test": "node --test tests/smoke.test.ts tests/automation/*.test.ts",
    "test:automation": "node --test tests/automation/*.test.ts",
    "automation:canary": "node scripts/automation/release.mjs canary --execute",
    "automation:canary:dry-run": "node scripts/automation/release.mjs canary --dry-run",
    "automation:secret-scan": "node scripts/automation/secret-scan.mjs",
    "automation:preflight": "scripts/automation/run-with-env.sh node scripts/automation/preflight.mjs",
    "automation:dry-run": "node scripts/automation/dry-run.mjs",
    "automation:record-release": "node scripts/automation/record-release.mjs",
    "automation:substack-auth": "scripts/automation/run-with-env.sh node scripts/automation/substack-auth.mjs"
  },
  "files": [
    "dist",
    "config",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodePuri/skill-surge.git"
  },
  "homepage": "https://github.com/CodePuri/skill-surge#readme",
  "bugs": {
    "url": "https://github.com/CodePuri/skill-surge/issues"
  },
  "keywords": [
    "ai-skills",
    "agent",
    "claude",
    "skills",
    "cli",
    "black-terminal",
    "agent-intelligence"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "^1.61.0",
    "typescript": "^5.8.0"
  },
  "license": "MIT"
}
