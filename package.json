{
  "name": "skill-surge",
  "version": "2.3.0",
  "description": "Your agent's skill library. 37 curated skills. Auto-install to Claude Code, OpenCode, Cline, and more.",
  "type": "module",
  "bin": {
    "skill-surge": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/smoke.test.js",
    "verify": "npm run typecheck && npm test",
    "prepublishOnly": "npm run verify"
  },
  "files": [
    "dist",
    "config",
    "skills/original",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodePuri/skill-surge.git"
  },
  "homepage": "https://github.com/CodePuri/skill-surge#readme",
  "bugs": {
    "url": "https://github.com/CodePuri/skill-surge/issues"
  },
  "keywords": [
    "ai-skills",
    "agent",
    "claude",
    "skills",
    "cli",
    "black-terminal",
    "agent-intelligence"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "license": "MIT"
}
